@page
@model AdminDashboard.Pages.IndexModel
@{
    ViewData["Title"] = "Admin Dashboard | News Stand NG";
}

<div class="container-fluid px-4 py-3">

    <!-- SaaS Page Header -->
    <div class="saas-page-header">
        <div>
            <div class="d-flex align-items-center gap-3">
                <h1 class="saas-page-title mb-0"><i class="bi bi-newspaper text-info"></i> Stories &amp; Feeds</h1>
                @if (Model.IsUpToDate)
                {
                    <span class="badge bg-success rounded-pill px-3 py-1 text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.5px;"><i class="bi bi-shield-check me-1"></i> Storage Up-To-Date</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark rounded-pill px-3 py-1 text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.5px;"><i class="bi bi-arrow-repeat me-1"></i> Auto-Refreshing Feed</span>
                }
            </div>
            <p class="saas-page-desc mt-1">Aggregated Nigerian news archive, live RSS channel streams &amp; executive briefings</p>
        </div>
        <div class="saas-toolbar">
            <form method="get" class="d-flex align-items-center gap-2">
                <input type="hidden" name="selectedChannel" value="@Model.SelectedChannel" />
                <input type="hidden" name="selectedCategory" value="@Model.SelectedCategory" />
                <input type="hidden" name="aiSummaryFilter" value="@Model.AiSummaryFilter" />
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-transparent border-glass text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchQuery" value="@Model.SearchQuery" placeholder="Search keywords..." class="form-control form-control-glass" style="width: 200px;" />
                </div>
                <button type="submit" class="btn btn-saas-secondary btn-sm"><i class="bi bi-search"></i> Search</button>
            </form>
            <a href="/" class="btn btn-saas-primary btn-sm"><i class="bi bi-arrow-clockwise"></i> Refresh Storage</a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show glass-card border-success text-white mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show glass-card border-danger text-white mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat Metrics Row -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-xl">
            <div class="glass-card stat-card">
                <div class="text-muted small text-uppercase font-weight-bold">Archived Stories</div>
                <div class="stat-value">@Model.TotalArticlesCount</div>
                <div class="small text-info mt-1"><i class="bi bi-archive-fill me-1"></i> Permanent Storage</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl">
            <div class="glass-card stat-card">
                <div class="text-muted small text-uppercase font-weight-bold">Today's Fresh Stories</div>
                <div class="stat-value">@Model.TodayArticlesCount</div>
                <div class="small text-success mt-1"><i class="bi bi-calendar-check me-1"></i> Up to Date (@DateTime.UtcNow.ToString("yyyy-MM-dd"))</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl">
            <div class="glass-card stat-card">
                <div class="text-muted small text-uppercase font-weight-bold">AI Summaries</div>
                <div class="stat-value text-warning">@Model.AiSummaryCount</div>
                <div class="small text-warning mt-1"><i class="bi bi-stars me-1"></i> Executive Briefings</div>
            </div>
        </div>
        <div class="col-6 col-md-6 col-xl">
            <div class="glass-card stat-card">
                <div class="text-muted small text-uppercase font-weight-bold">Active News Channels</div>
                <div class="stat-value">@(Model.Channels.Count - 1)</div>
                <div class="small text-warning mt-1"><i class="bi bi-rss me-1"></i> Scraped Feeds</div>
            </div>
        </div>
        <div class="col-6 col-md-6 col-xl">
            <div class="glass-card stat-card">
                <div class="text-muted small text-uppercase font-weight-bold">Active Topic / Keyword</div>
                <div class="stat-value text-truncate" style="font-size: 1.3rem;" title="@Model.SelectedCategory">@Model.SelectedCategory</div>
                <div class="small text-muted mt-1"><i class="bi bi-search me-1"></i> Query: @(string.IsNullOrEmpty(Model.SearchQuery) ? "All Keywords" : Model.SearchQuery)</div>
            </div>
        </div>
    </div>

    <!-- Main Grid Layout: Left Stories Feed, Right Channel Manager -->
    <div class="row g-4">

        <!-- Main Column: Stories Feed & Filter Tabs -->
        <div class="col-lg-8 col-xl-9">

            <!-- Channel Filter Pills -->
            <div class="glass-card p-3 mb-4">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h5 class="text-white mb-0 brand-font"><i class="bi bi-newspaper me-2 text-info"></i> News Channels</h5>
                    <span class="text-muted small">Select a channel to view stories</span>
                </div>
                <div class="channel-pills mt-2">
                    @foreach (var ch in Model.Channels)
                    {
                        var isActive = string.Equals(Model.SelectedChannel, ch, StringComparison.OrdinalIgnoreCase);
                        var url = Url.Page("/Index", new { selectedChannel = ch, selectedCategory = Model.SelectedCategory, searchQuery = Model.SearchQuery, aiSummaryFilter = Model.AiSummaryFilter });
                        <a href="@url" class="channel-pill @(isActive ? "active" : "")">
                            @if (ch == "All")
                            {
                                <i class="bi bi-grid-fill"></i> <span>All Channels</span>
                            }
                            else
                            {
                                <i class="bi bi-broadcast"></i> <span>@ch</span>
                            }
                        </a>
                    }
                </div>

                <!-- Category Sub-Filters -->
                <div class="d-flex align-items-center gap-2 mt-3 pt-3 border-top border-secondary border-opacity-25 flex-wrap">
                    <span class="text-muted small me-2"><i class="bi bi-tag-fill"></i> Category:</span>
                    @foreach (var cat in Model.Categories)
                    {
                        var isCatActive = string.Equals(Model.SelectedCategory, cat, StringComparison.OrdinalIgnoreCase);
                        var catUrl = Url.Page("/Index", new { selectedChannel = Model.SelectedChannel, selectedCategory = cat, searchQuery = Model.SearchQuery, aiSummaryFilter = Model.AiSummaryFilter });
                        <a href="@catUrl" class="btn btn-sm @(isCatActive ? "btn-info text-dark" : "btn-outline-secondary text-light") rounded-pill py-1 px-3" style="font-size: 0.8rem;">
                            @cat
                        </a>
                    }
                </div>

                <!-- AI Summary Filter Sub-Tabs -->
                <div class="d-flex align-items-center gap-2 mt-2 pt-2 border-top border-secondary border-opacity-25 flex-wrap">
                    <span class="text-muted small me-2"><i class="bi bi-stars text-warning"></i> AI Summary:</span>
                    @{
                        var allAiUrl = Url.Page("/Index", new { selectedChannel = Model.SelectedChannel, selectedCategory = Model.SelectedCategory, searchQuery = Model.SearchQuery, aiSummaryFilter = "All" });
                        var withAiUrl = Url.Page("/Index", new { selectedChannel = Model.SelectedChannel, selectedCategory = Model.SelectedCategory, searchQuery = Model.SearchQuery, aiSummaryFilter = "WithSummary" });
                        var withoutAiUrl = Url.Page("/Index", new { selectedChannel = Model.SelectedChannel, selectedCategory = Model.SelectedCategory, searchQuery = Model.SearchQuery, aiSummaryFilter = "WithoutSummary" });
                    }
                    <a href="@allAiUrl" class="btn btn-sm @(Model.AiSummaryFilter == "All" ? "btn-warning text-dark fw-bold" : "btn-outline-secondary text-light") rounded-pill py-0.5 px-3" style="font-size: 0.78rem;">
                        All Stories
                    </a>
                    <a href="@withAiUrl" class="btn btn-sm @(Model.AiSummaryFilter == "WithSummary" ? "btn-warning text-dark fw-bold" : "btn-outline-secondary text-light") rounded-pill py-0.5 px-3" style="font-size: 0.78rem;">
                        <i class="bi bi-stars me-1"></i> With AI Summary (@Model.AiSummaryCount)
                    </a>
                    <a href="@withoutAiUrl" class="btn btn-sm @(Model.AiSummaryFilter == "WithoutSummary" ? "btn-warning text-dark fw-bold" : "btn-outline-secondary text-light") rounded-pill py-0.5 px-3" style="font-size: 0.78rem;">
                        <i class="bi bi-cpu me-1"></i> Needs AI Summary
                    </a>
                </div>
            </div>

            <!-- Section Title -->
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h4 class="text-white mb-0 brand-font">
                    Mobile App Feed Preview 
                    <span class="badge bg-secondary rounded-pill font-weight-normal ms-2" style="font-size: 0.8rem;">@Model.Articles.Count stories</span>
                </h4>
                @if (Model.SelectedChannel != "All" || Model.SelectedCategory != "All" || Model.AiSummaryFilter != "All" || !string.IsNullOrEmpty(Model.SearchQuery))
                {
                    <a href="/Index" class="btn btn-link text-info p-0 text-decoration-none small"><i class="bi bi-x-circle"></i> Clear Filters</a>
                }
            </div>

            <!-- News Cards Grid -->
            @if (!Model.Articles.Any())
            {
                <div class="glass-card p-5 text-center my-4">
                    <div class="text-muted display-4 mb-3"><i class="bi bi-newspaper"></i></div>
                    <h4 class="text-white">No News Stories Found</h4>
                    <p class="text-muted">There are no articles matching channel "<strong>@Model.SelectedChannel</strong>" and category "<strong>@Model.SelectedCategory</strong>".</p>
                    <a href="/Index" class="btn btn-gradient btn-sm mt-2">View All Stories</a>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var article in Model.Articles)
                    {
                        var articleUrl = string.IsNullOrWhiteSpace(article.Url) ? "#" : article.Url;
                        var cleanTitle = AdminDashboard.Pages.IndexModel.CleanHtml(article.Title);
                        var cleanSummary = AdminDashboard.Pages.IndexModel.CleanHtml(article.Summary ?? string.Empty);
                        <div class="col-md-6 col-xl-4">
                            <div class="article-card" id="article-card-@article.Id">
                                <div class="article-img-wrapper">
                                    <a href="@articleUrl" target="_blank" rel="noopener noreferrer" title="Read full story on @article.Source">
                                        <img src="@article.ImageUrl" alt="@cleanTitle" class="article-img" onerror="this.src='https://images.unsplash.com/photo-1585829365295-ab7cd400c167?w=600&auto=format&fit=crop&q=80'" />
                                    </a>
                                    <span class="source-badge">@article.Source</span>
                                    @if (article.HasAiSummary)
                                    {
                                        var engineLabel = article.AiSummaryEngine?.Contains("Gemini", StringComparison.OrdinalIgnoreCase) == true ? "Gemini Flash" : "AI Briefing";
                                        <span class="ai-summary-badge" title="AI Executive Briefing Available (@(article.AiSummaryEngine ?? "Gemini-3.1-Flash-Lite"))">
                                            <i class="bi bi-stars"></i> @engineLabel
                                        </span>
                                    }
                                    <form method="post" asp-page-handler="UpdateCategory" class="position-absolute top-0 end-0 m-2">
                                        <input type="hidden" name="articleId" value="@article.Id" />
                                        <select name="newCategory" class="form-select form-select-sm border-info text-white bg-dark bg-opacity-90 py-0 px-2 rounded-pill shadow-sm" style="font-size: 0.72rem; height: 26px; cursor: pointer;" onchange="updateArticleCategory(this, '@article.Id')" title="Re-categorize story to train ML model">
                                            <option value="Politics"      selected="@(article.Category == "Politics"      ? "selected" : null)">🏷️ Politics</option>
                                            <option value="Business"      selected="@(article.Category == "Business"      ? "selected" : null)">🏷️ Business</option>
                                            <option value="Sports"        selected="@(article.Category == "Sports"        ? "selected" : null)">🏷️ Sports</option>
                                            <option value="Entertainment" selected="@(article.Category == "Entertainment" ? "selected" : null)">🏷️ Entertainment</option>
                                            <option value="Technology"    selected="@(article.Category == "Technology"    ? "selected" : null)">🏷️ Technology</option>
                                            <option value="Crime"         selected="@(article.Category == "Crime"         ? "selected" : null)">🏷️ Crime</option>
                                            <option value="International" selected="@(article.Category == "International" ? "selected" : null)">🌐 International</option>
                                            <option value="General"       selected="@(article.Category == "General"       ? "selected" : null)">🏷️ General</option>
                                        </select>
                                    </form>
                                </div>
                                <div class="article-body">
                                    <a href="@articleUrl" target="_blank" rel="noopener noreferrer" class="article-title-link">
                                        <h5 class="article-title" title="@cleanTitle">@cleanTitle</h5>
                                    </a>
                                    <p class="article-summary">@(string.IsNullOrWhiteSpace(cleanSummary) ? "No detailed summary available." : cleanSummary)</p>
                                    
                                    <div class="article-meta">
                                        <span><i class="bi bi-clock me-1"></i> @article.PublishedAt.ToString("MMM dd, HH:mm")</span>
                                        <div class="d-flex align-items-center gap-1.5 ms-auto flex-wrap justify-content-end">
                                            @if (article.HasAiSummary)
                                            {
                                                <button type="button" class="btn-ai-summary" onclick="viewAiSummary('@article.Id', '@JavaScriptEncoder.Default.Encode(cleanTitle)', '@(article.AiSummaryEngine ?? "Gemini-3.1-Flash-Lite")')" title="View AI Executive Summary & Takeaways">
                                                    <i class="bi bi-stars"></i> AI Summary
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn-ai-generate" onclick="generateAiSummary('@article.Id', this, '@JavaScriptEncoder.Default.Encode(cleanTitle)')" title="Generate AI Executive Briefing now">
                                                    <i class="bi bi-lightning-charge"></i> Generate AI
                                                </button>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(article.Url))
                                            {
                                                <a href="@article.Url" target="_blank" rel="noopener noreferrer" class="btn-open-source" title="Open news source">
                                                    <i class="bi bi-box-arrow-up-right"></i> Source
                                                </a>
                                            }
                                            <button type="button" class="btn-share" onclick="shareArticle('@JavaScriptEncoder.Default.Encode(articleUrl)', '@JavaScriptEncoder.Default.Encode(cleanTitle)', '@JavaScriptEncoder.Default.Encode(article.Source)')" title="Share story">
                                                <i class="bi bi-share-fill"></i> Share
                                            </button>
                                            @if (!string.IsNullOrEmpty(article.AudioUrl))
                                            {
                                                <span class="btn-audio" onclick="playAudio('@article.AudioUrl', '@JavaScriptEncoder.Default.Encode(cleanTitle)')" style="cursor: pointer;" title="Listen to audio briefing">
                                                    <i class="bi bi-volume-up-fill"></i> Audio
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

        </div>

        <!-- Sidebar Column: Source Management & RSS Controls -->
        <div class="col-lg-4 col-xl-3">

            <!-- Add Source Card -->
            <div class="glass-card p-4 mb-4">
                <h5 class="text-white mb-3 brand-font"><i class="bi bi-plus-circle-fill text-info me-2"></i> Add News Channel</h5>
                <form method="post" asp-page-handler="AddSource">
                    <div class="mb-3">
                        <label class="form-label text-muted small">Channel Name</label>
                        <input asp-for="NewSource.Name" class="form-control form-control-glass" placeholder="e.g. Daily Post Nigeria" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">Google News Sitemap URL (Recommended)</label>
                        <input asp-for="NewSource.SitemapUrl" class="form-control form-control-glass" placeholder="https://dailypost.ng/news-sitemap.xml" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">RSS Feed URL (Fallback)</label>
                        <input asp-for="NewSource.RssUrl" class="form-control form-control-glass" placeholder="https://dailypost.ng/feed/" />
                    </div>
                    <button class="btn btn-gradient w-100"><i class="bi bi-plus-lg"></i> Add Channel Source</button>
                </form>
            </div>

            <!-- Existing Channels List -->
            <div class="glass-card p-4 mb-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h5 class="text-white mb-0 brand-font"><i class="bi bi-rss-fill text-warning me-2"></i> Active Ingestion Sources</h5>
                    <span class="badge bg-primary rounded-pill">@Model.Sources.Count</span>
                </div>
                <div class="list-group list-group-flush bg-transparent">
                    @foreach (var source in Model.Sources)
                    {
                        <div class="list-group-item bg-transparent text-white border-secondary border-opacity-25 px-0 py-2.5 d-flex align-items-center justify-content-between">
                            <div>
                                <div class="font-weight-bold text-white small d-flex align-items-center gap-1.5">
                                    @source.Name
                                    @if (!string.IsNullOrEmpty(source.SitemapUrl))
                                    {
                                        <span class="badge bg-info text-dark" style="font-size: 0.62rem; padding: 2px 5px;">SITEMAP</span>
                                    }
                                    @if (!string.IsNullOrEmpty(source.RssUrl))
                                    {
                                        <span class="badge bg-secondary" style="font-size: 0.62rem; padding: 2px 5px;">RSS</span>
                                    }
                                </div>
                                <div class="text-muted" style="font-size: 0.72rem; max-width: 170px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    @(source.SitemapUrl ?? source.RssUrl ?? "Auto-scraped")
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <form method="post" asp-page-handler="ScrapeSource" class="d-inline">
                                    <input type="hidden" name="id" value="@source.Id" />
                                    <button class="btn btn-outline-info btn-sm p-1 px-2" style="font-size: 0.75rem;" title="Scrape source now">
                                        <i class="bi bi-arrow-repeat"></i>
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="RemoveSource" class="d-inline">
                                    <input type="hidden" name="id" value="@source.Id" />
                                    <button class="btn btn-outline-danger btn-sm p-1 px-2" style="font-size: 0.75rem;" title="Remove source">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- System Info & Mobile App Notes -->
            <div class="glass-card p-4">
                <h5 class="text-white mb-2 brand-font"><i class="bi bi-info-circle-fill text-cyan me-2"></i> Mobile App Sync</h5>
                <p class="text-muted small mb-2">Stories displayed above are consumed directly by the .NET MAUI mobile app via REST API <code>/api/v1/briefings</code>.</p>
                <div class="p-2.5 rounded bg-dark bg-opacity-50 border border-secondary border-opacity-25 small text-light">
                    <div><i class="bi bi-translate text-info me-1"></i> Multilingual Voices:</div>
                    <ul class="mb-0 ps-3 mt-1 text-muted" style="font-size: 0.78rem;">
                        <li>English (Female)</li>
                        <li>Yoruba (Female)</li>
                        <li>Igbo (Female)</li>
                        <li>Hausa (Female)</li>
                    </ul>
                </div>
            </div>

        </div>

    </div>

</div>

<!-- AI Executive Summary Details Modal -->
<div class="modal fade" id="aiSummaryModal" tabindex="-1" aria-labelledby="aiSummaryModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-card border-0 text-white shadow-lg" style="background: rgba(15, 23, 42, 0.95); backdrop-filter: blur(20px);">
            <div class="modal-header border-secondary border-opacity-25 pb-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-purple px-2.5 py-1 rounded-pill" id="aiModalEngineBadge">
                        <i class="bi bi-stars me-1"></i> Gemini 1.5 Flash
                    </span>
                    <span class="text-muted small" id="aiModalReadingTime"><i class="bi bi-clock me-1"></i> ~45 sec read</span>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-3">
                <h5 class="modal-title fw-bold text-white mb-3" id="aiSummaryModalTitle">Article Headline</h5>

                <!-- Loading State -->
                <div id="aiModalLoading" class="text-center py-4">
                    <div class="spinner-border text-info" role="status">
                        <span class="visually-hidden">Loading AI briefing...</span>
                    </div>
                    <div class="text-muted small mt-2">Retrieving AI executive briefing...</div>
                </div>

                <!-- Content Area -->
                <div id="aiModalContent" style="display: none;">
                    <!-- Executive Overview -->
                    <div class="p-3 mb-3 rounded-3" style="background: rgba(168, 85, 247, 0.12); border-left: 4px solid #a855f7;">
                        <div class="fw-bold text-warning small text-uppercase mb-1"><i class="bi bi-lightning-fill me-1"></i> Executive Overview</div>
                        <p class="mb-0 text-light" id="aiModalOverview" style="line-height: 1.6; font-size: 0.95rem;"></p>
                    </div>

                    <!-- Key Takeaways -->
                    <div class="mb-3">
                        <div class="fw-bold text-info small text-uppercase mb-2"><i class="bi bi-check2-circle me-1"></i> Key Takeaways</div>
                        <div id="aiModalTakeaways"></div>
                    </div>

                    <!-- Context & Background -->
                    <div class="mb-3" id="aiModalContextSection" style="display:none;">
                        <div class="fw-bold text-light small text-uppercase mb-2"><i class="bi bi-info-circle me-1"></i> Context &amp; Background</div>
                        <ul class="text-muted small ps-3 mb-0" id="aiModalContextList"></ul>
                    </div>

                    <!-- Timeline Facts & Numbers -->
                    <div class="mb-3" id="aiModalTimelineSection" style="display:none;">
                        <div class="fw-bold text-warning small text-uppercase mb-2"><i class="bi bi-calendar-event me-1"></i> Key Facts &amp; Timeline</div>
                        <div id="aiModalTimelineFacts"></div>
                    </div>

                    <!-- Structured FAQs -->
                    <div class="mb-2" id="aiModalFaqSection" style="display:none;">
                        <div class="fw-bold text-success small text-uppercase mb-2"><i class="bi bi-question-circle me-1"></i> Frequently Asked Questions</div>
                        <div class="accordion accordion-flush" id="aiModalFaqAccordion"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-secondary border-opacity-25 pt-2">
                <button type="button" class="btn btn-outline-light btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Audio Player Modal -->
<div class="modal fade" id="audioModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-card border-info text-white" style="background: #0f172a;">
            <div class="modal-header border-secondary border-opacity-25">
                <h5 class="modal-title brand-font text-info" id="audioModalTitle"><i class="bi bi-volume-up-fill me-2"></i> Audio Briefing Player</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <div class="mb-3 text-muted" id="audioTrackName">Audio Clip</div>
                <audio id="modalAudioPlayer" controls class="w-100" style="outline: none;">
                    Your browser does not support the audio element.
                </audio>
            </div>
        </div>
    </div>
</div>

<!-- Share Feedback Toast Container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100;">
    <div id="shareToast" class="toast align-items-center text-white bg-dark border border-cyan shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill text-info fs-5"></i>
                <span id="toastMessage">Link copied to clipboard!</span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function playAudio(url, title) {
            document.getElementById('audioModalTitle').innerHTML = '<i class="bi bi-volume-up-fill me-2"></i> Audio Preview';
            document.getElementById('audioTrackName').innerText = title || 'Audio Briefing';
            var player = document.getElementById('modalAudioPlayer');
            player.src = url;
            var modal = new bootstrap.Modal(document.getElementById('audioModal'));
            modal.show();
            player.play();
        }

        function shareArticle(url, title, source) {
            if (!url || url === '#') {
                showToast('No URL available for this story.', 'warning');
                return;
            }

            var shareData = {
                title: title + ' - ' + source,
                text: title + ' (' + source + ')',
                url: url
            };

            if (navigator.share && navigator.canShare && navigator.canShare(shareData)) {
                navigator.share(shareData).catch(function(err) {
                    console.log('Share canceled or non-fatal:', err);
                });
            } else {
                navigator.clipboard.writeText(url).then(function() {
                    showToast('Story link copied to clipboard!');
                }).catch(function() {
                    prompt('Copy story link:', url);
                });
            }
        }

        async function updateArticleCategory(selectElement, articleId) {
            var newCategory = selectElement.value;
            var form = selectElement.closest('form');
            var tokenInput = form ? form.querySelector('input[name="__RequestVerificationToken"]') : null;
            var token = tokenInput ? tokenInput.value : '';

            var formData = new FormData();
            formData.append('articleId', articleId);
            formData.append('newCategory', newCategory);
            if (token) {
                formData.append('__RequestVerificationToken', token);
            }

            try {
                var response = await fetch('/Index?handler=UpdateCategory', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                if (response.ok) {
                    var data = await response.json();
                    showToast(data.message || ('Category updated to ' + newCategory + '!'));
                } else {
                    showToast('Failed to update category.', 'warning');
                }
            } catch (err) {
                console.error('Error updating category:', err);
                showToast('Error updating category.', 'warning');
            }
        }

        function escapeHtml(str) {
            if (str === null || str === undefined) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        async function viewAiSummary(articleId, title, engine) {
            document.getElementById('aiSummaryModalTitle').innerText = title || 'Executive Briefing';
            var engineBadge = document.getElementById('aiModalEngineBadge');
            if (engineBadge) {
                engineBadge.innerHTML = '<i class="bi bi-stars me-1"></i> ' + escapeHtml(engine || 'Gemini 1.5 Flash');
            }
            document.getElementById('aiModalLoading').style.display = 'block';
            document.getElementById('aiModalContent').style.display = 'none';

            var modal = new bootstrap.Modal(document.getElementById('aiSummaryModal'));
            modal.show();

            try {
                var response = await fetch('/Index?handler=ArticleEnrichment&id=' + encodeURIComponent(articleId));
                var data = await response.json();

                if (data.success && data.enrichment) {
                    renderEnrichmentModal(data.enrichment);
                } else if (data.success && data.summary) {
                    renderEnrichmentModal({ fullSummary: data.summary, engine: engine || 'Gemini-3.1-Flash-Lite' });
                } else {
                    document.getElementById('aiModalLoading').innerHTML = '<div class="text-warning p-3"><i class="bi bi-exclamation-circle me-1"></i> ' + escapeHtml(data.message || 'No AI summary available.') + '</div>';
                }
            } catch (err) {
                console.error('Error fetching AI summary:', err);
                document.getElementById('aiModalLoading').innerHTML = '<div class="text-danger p-3"><i class="bi bi-x-circle me-1"></i> Failed to load AI summary.</div>';
            }
        }

        function renderEnrichmentModal(enr) {
            document.getElementById('aiModalLoading').style.display = 'none';
            document.getElementById('aiModalContent').style.display = 'block';

            var full = enr.fullSummary;
            var overviewEl = document.getElementById('aiModalOverview');
            if (full && full.executiveOverview) {
                overviewEl.innerText = full.executiveOverview;
                overviewEl.parentElement.style.display = 'block';
            } else if (enr.keyTakeaways && enr.keyTakeaways.length > 0) {
                overviewEl.innerText = enr.keyTakeaways[0];
                overviewEl.parentElement.style.display = 'block';
            } else {
                overviewEl.parentElement.style.display = 'none';
            }

            var readingTimeEl = document.getElementById('aiModalReadingTime');
            if (full && full.readingTimeSeconds) {
                readingTimeEl.innerHTML = '<i class="bi bi-clock me-1"></i> ~' + escapeHtml(full.readingTimeSeconds) + ' sec read';
            }

            var takeawaysEl = document.getElementById('aiModalTakeaways');
            takeawaysEl.innerHTML = '';
            var takeaways = (enr.keyTakeaways && enr.keyTakeaways.length > 0) ? enr.keyTakeaways : (full ? full.contextAndBackground : []);
            if (takeaways && takeaways.length > 0) {
                takeaways.forEach(function(t) {
                    var div = document.createElement('div');
                    div.className = 'ai-takeaway-item';
                    div.innerHTML = '<i class="bi bi-check-circle-fill text-info me-2"></i>' + escapeHtml(t);
                    takeawaysEl.appendChild(div);
                });
            } else {
                takeawaysEl.innerHTML = '<p class="text-muted small">No bullet points available.</p>';
            }

            var contextSec = document.getElementById('aiModalContextSection');
            var contextList = document.getElementById('aiModalContextList');
            if (full && full.contextAndBackground && full.contextAndBackground.length > 0) {
                contextList.innerHTML = '';
                full.contextAndBackground.forEach(function(c) {
                    var li = document.createElement('li');
                    li.className = 'mb-1';
                    li.innerText = c;
                    contextList.appendChild(li);
                });
                contextSec.style.display = 'block';
            } else {
                contextSec.style.display = 'none';
            }

            var timelineSec = document.getElementById('aiModalTimelineSection');
            var timelineEl = document.getElementById('aiModalTimelineFacts');
            if (enr.timelineFacts && enr.timelineFacts.length > 0) {
                timelineEl.innerHTML = '';
                enr.timelineFacts.forEach(function(f) {
                    var item = document.createElement('div');
                    item.className = 'small text-light mb-1 p-2 rounded';
                    item.style.background = 'rgba(255,255,255,0.03)';
                    item.innerHTML = '<span class="badge bg-warning text-dark me-2">' + escapeHtml(f.dateText || 'Fact') + '</span> ' + escapeHtml(f.fact);
                    timelineEl.appendChild(item);
                });
                timelineSec.style.display = 'block';
            } else if (full && full.keyFiguresAndEntities && full.keyFiguresAndEntities.length > 0) {
                timelineEl.innerHTML = '';
                full.keyFiguresAndEntities.forEach(function(k) {
                    var item = document.createElement('div');
                    item.className = 'small text-light mb-1 p-2 rounded';
                    item.style.background = 'rgba(255,255,255,0.03)';
                    item.innerHTML = '<i class="bi bi-tag-fill text-warning me-2"></i>' + escapeHtml(k);
                    timelineEl.appendChild(item);
                });
                timelineSec.style.display = 'block';
            } else {
                timelineSec.style.display = 'none';
            }

            var faqSec = document.getElementById('aiModalFaqSection');
            var faqAcc = document.getElementById('aiModalFaqAccordion');
            if (enr.faqs && enr.faqs.length > 0) {
                faqAcc.innerHTML = '';
                enr.faqs.forEach(function(faq, idx) {
                    var item = document.createElement('div');
                    item.className = 'accordion-item bg-transparent border-secondary border-opacity-25';
                    item.innerHTML = '<h2 class="accordion-header" id="heading' + idx + '">' +
                        '<button class="accordion-button collapsed bg-transparent text-light py-2 px-0" type="button" data-bs-toggle="collapse" data-bs-target="#collapse' + idx + '">' +
                        '<span class="fw-semibold small text-info me-2">Q:</span> <span class="small">' + escapeHtml(faq.question) + '</span></button></h2>' +
                        '<div id="collapse' + idx + '" class="accordion-collapse collapse" data-bs-parent="#aiModalFaqAccordion">' +
                        '<div class="accordion-body text-light small px-0 pt-1 pb-3">' + escapeHtml(faq.answer) + '</div></div>';
                    faqAcc.appendChild(item);
                });
                faqSec.style.display = 'block';
            } else {
                faqSec.style.display = 'none';
            }
        }

        async function generateAiSummary(articleId, btnElement, title) {
            var origHtml = btnElement.innerHTML;
            btnElement.disabled = true;
            btnElement.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span> Generating...';

            var form = document.querySelector('form[method="post"]');
            var tokenInput = form ? form.querySelector('input[name="__RequestVerificationToken"]') : null;
            var token = tokenInput ? tokenInput.value : '';

            var formData = new FormData();
            formData.append('id', articleId);
            if (token) formData.append('__RequestVerificationToken', token);

            try {
                var response = await fetch('/Index?handler=GenerateAiSummary&id=' + encodeURIComponent(articleId), {
                    method: 'POST',
                    body: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                var data = await response.json();
                if (data.success) {
                    showToast('AI Executive Briefing generated!');
                    btnElement.className = 'btn-ai-summary';
                    btnElement.innerHTML = '<i class="bi bi-stars"></i> AI Summary';
                    btnElement.disabled = false;
                    btnElement.onclick = function() {
                        viewAiSummary(articleId, title, data.engine || 'Gemini-3.1-Flash-Lite');
                    };

                    var card = document.getElementById('article-card-' + articleId);
                    if (card) {
                        var imgWrap = card.querySelector('.article-img-wrapper');
                        if (imgWrap && !imgWrap.querySelector('.ai-summary-badge')) {
                            var badge = document.createElement('span');
                            badge.className = 'ai-summary-badge';
                            badge.title = 'AI Executive Briefing Available (Gemini 3.1 Flash-Lite)';
                            badge.innerHTML = '<i class="bi bi-stars"></i> Gemini Flash';
                            imgWrap.appendChild(badge);
                        }
                    }

                    // Open the modal right away to preview
                    viewAiSummary(articleId, title, data.engine || 'Gemini-3.1-Flash-Lite');
                } else {
                    btnElement.innerHTML = origHtml;
                    btnElement.disabled = false;
                    showToast(data.message || 'Failed to generate AI summary', 'warning');
                }
            } catch (err) {
                console.error('Error generating AI summary:', err);
                btnElement.innerHTML = origHtml;
                btnElement.disabled = false;
                showToast('Error generating AI summary.', 'warning');
            }
        }

        function showToast(message, type) {
            var msgEl = document.getElementById('toastMessage');
            if (msgEl) {
                msgEl.innerText = message;
            }
            var toastEl = document.getElementById('shareToast');
            if (toastEl) {
                var toast = new bootstrap.Toast(toastEl, { delay: 3000 });
                toast.show();
            }
        }
    </script>
}

