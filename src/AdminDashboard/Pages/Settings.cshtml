                                    <div class="p-3 rounded border border-warning-subtle bg-warning-subtle bg-opacity-10">
                                        <div class="text-warning fw-bold small"><i class="bi bi-info-circle me-1"></i> WhatsApp Routing Inactive</div>
                                        <div class="text-muted" style="font-size: 0.8rem;">No WhatsApp number configured. Contact page will default to email dispatch to Admin@newsstand.ng.</div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- 8. Facebook & Social Syndication -->
                    <div class="tab-pane fade" id="content-social" role="tabpanel">
