<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Minimalist Palette inspired by GoRead News App -->

    <!-- ── Nigerian Brand Greens ───────────────────────── -->
    <Color x:Key="NigerianGreen">#1B6B3A</Color>
    <Color x:Key="NigerianGreenMid">#2A8A50</Color>
    <Color x:Key="NigerianGreenLight">#3DAB69</Color>
    <Color x:Key="NigerianGreenGlow">#6FCFA0</Color>
    <Color x:Key="AccentGreen">#1B6B3A</Color>
    <Color x:Key="AccentGreenLight">#EAF2EC</Color>
    <Color x:Key="BrandGreen">#1B6B3A</Color>

    <!-- ── Verified / Accent ───────────────────────────── -->
    <Color x:Key="VerifiedBlue">#1D9BF0</Color>

    <!-- Success / positive feedback color (used by reader mode badge) -->
    <Color x:Key="SuccessGreen">#28A745</Color>


    <Color x:Key="Primary">#1A1D20</Color>
    <Color x:Key="PrimaryDark">#111315</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>

    <!-- ── Splash & Canvas Backgrounds (Green-Tinted White) ── -->
    <Color x:Key="SplashBackground">#EEF6F1</Color>
    <Color x:Key="AppBackground">#F6FAF7</Color>

    <!-- Clean Green-Tinted White Canvas & Soft Pill Backgrounds -->
    <Color x:Key="Secondary">#EAF2EC</Color>
    <Color x:Key="SecondaryLight">#F6FAF7</Color>
    <Color x:Key="SecondaryDarkText">#1A1D20</Color>

    <!-- Electric Blue Accent (GoRead Pill Blue) -->
    <Color x:Key="AccentBlue">#0066FF</Color>
    <Color x:Key="AccentBlueLight">#EBF3FF</Color>

    <!-- Warm Accent -->
    <Color x:Key="AccentOrange">#FF7A00</Color>
    <Color x:Key="AccentOrangeLight">#FFF4EB</Color>
    <Color x:Key="Magenta">#D81B60</Color>

    <!-- ── Video & Social Category Accents ────────────── -->
    <Color x:Key="VideoRed">#FF0000</Color>
    <Color x:Key="VideoRedDark">#CC0000</Color>
    <Color x:Key="VideoRedLight">#FFECEC</Color>
    <Color x:Key="SocialBlue">#1D9BF0</Color>
    <Color x:Key="SocialBlueLight">#E8F5FE</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="OffBlack">#1F1F1F</Color>

    <Color x:Key="Gray100">#E4ECE6</Color>
    <Color x:Key="Gray200">#D5E2D8</Color>
    <Color x:Key="Gray300">#C6D4CA</Color>
    <Color x:Key="Gray400">#ADB5BD</Color>
    <Color x:Key="Gray500">#6C757D</Color>
    <Color x:Key="MidnightBlue">#0F172A</Color>
    <Color x:Key="Gray600">#495057</Color>
    <Color x:Key="Gray700">#334155</Color>
    <Color x:Key="Gray800">#1E293B</Color>
    <Color x:Key="Gray900">#212529</Color>
    <Color x:Key="Gray950">#111111</Color>

    <!-- Dark mode base colors -->
    <Color x:Key="DarkSurface">#121212</Color>
    <Color x:Key="DarkSurfaceElevated">#1E1E1E</Color>
    <Color x:Key="DarkSurfaceCard">#2A2A2A</Color>
    <Color x:Key="DarkPrimary">#60A5FA</Color>
    <Color x:Key="DarkSecondary">#1E293B</Color>
    <Color x:Key="DarkAccentOrange">#FF9D42</Color>
    <Color x:Key="DarkAccentOrangeLight">#332211</Color>
    <Color x:Key="DarkTextPrimary">#F8FAFC</Color>
    <Color x:Key="DarkTextSecondary">#94A3B8</Color>
    <Color x:Key="DarkAccentGreen">#4ADE80</Color>
    <Color x:Key="DarkAccentGreenLight">#0F3820</Color>

    <!-- ── High-Contrast Button Color Tokens ── -->
    <Color x:Key="ButtonBorderLight">#CBD5E1</Color>
    <Color x:Key="ButtonBorderDark">#475569</Color>
    <Color x:Key="ButtonBgLight">#FFFFFF</Color>
    <Color x:Key="ButtonBgDark">#1E293B</Color>
    <Color x:Key="ButtonTextLight">#0F172A</Color>
    <Color x:Key="ButtonTextDark">#FFFFFF</Color>
    <Color x:Key="ButtonSecondaryBgLight">#F1F5F9</Color>
    <Color x:Key="ButtonSecondaryBgDark">#273549</Color>

    <!-- Theme-aware brushes using AppThemeBinding -->
    <SolidColorBrush x:Key="PrimaryBrush"
                     Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush"
                     Color="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource DarkSecondary}}"/>
    <SolidColorBrush x:Key="SecondaryBrush"
                     Color="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource DarkSecondary}}"/>
    <SolidColorBrush x:Key="SecondaryLightBrush"
                     Color="{AppThemeBinding Light={StaticResource SecondaryLight}, Dark={StaticResource DarkSurfaceElevated}}"/>
    <SolidColorBrush x:Key="AccentBlueBrush"
                     Color="{AppThemeBinding Light={StaticResource AccentBlue}, Dark={StaticResource DarkPrimary}}"/>
    <SolidColorBrush x:Key="AccentBlueLightBrush"
                     Color="{AppThemeBinding Light={StaticResource AccentBlueLight}, Dark={StaticResource DarkSecondary}}"/>
    <SolidColorBrush x:Key="AccentOrangeBrush"
                     Color="{AppThemeBinding Light={StaticResource AccentOrange}, Dark={StaticResource DarkAccentOrange}}"/>
    <SolidColorBrush x:Key="AccentOrangeLightBrush"
                     Color="{AppThemeBinding Light={StaticResource AccentOrangeLight}, Dark={StaticResource DarkAccentOrangeLight}}"/>
    <SolidColorBrush x:Key="WhiteBrush"
                     Color="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSurface}}"/>
    <SolidColorBrush x:Key="AlwaysWhiteBrush"
                     Color="White"/>
    <SolidColorBrush x:Key="BlackBrush"
                     Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource DarkTextPrimary}}"/>

    <SolidColorBrush x:Key="Gray100Brush"
                     Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource DarkSurfaceCard}}"/>
    <SolidColorBrush x:Key="Gray200Brush"
                     Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource DarkSurfaceCard}}"/>
    <SolidColorBrush x:Key="Gray300Brush"
                     Color="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource DarkTextSecondary}}"/>
    <SolidColorBrush x:Key="Gray600Brush"
                     Color="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource DarkTextSecondary}}"/>
    <SolidColorBrush x:Key="Gray700Brush"
                     Color="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource DarkTextSecondary}}"/>
    <SolidColorBrush x:Key="Gray800Brush"
                     Color="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource DarkSurfaceCard}}"/>
    <SolidColorBrush x:Key="Gray900Brush"
                     Color="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource DarkTextPrimary}}"/>

    <!-- High-Contrast Button Brushes -->
    <SolidColorBrush x:Key="ButtonBorderBrush"
                     Color="{AppThemeBinding Light={StaticResource ButtonBorderLight}, Dark={StaticResource ButtonBorderDark}}"/>
    <SolidColorBrush x:Key="ButtonBgBrush"
                     Color="{AppThemeBinding Light={StaticResource ButtonBgLight}, Dark={StaticResource ButtonBgDark}}"/>
    <SolidColorBrush x:Key="ButtonTextBrush"
                     Color="{AppThemeBinding Light={StaticResource ButtonTextLight}, Dark={StaticResource ButtonTextDark}}"/>
    <SolidColorBrush x:Key="ButtonSecondaryBgBrush"
                     Color="{AppThemeBinding Light={StaticResource ButtonSecondaryBgLight}, Dark={StaticResource ButtonSecondaryBgDark}}"/>
</ResourceDictionary>