@page
@model AdminDashboard.Pages.CategorizerModel
@{
    ViewData["Title"] = "ML Categorizer & Re-Training Hub";
}

<div class="container-fluid px-4 py-3">

    <!-- SaaS Page Header -->
    <div class="saas-page-header">
        <div>
            <div class="d-flex align-items-center gap-3">
                <h1 class="saas-page-title mb-0"><i class="bi bi-cpu-fill text-purple"></i> ML Categorizer Hub</h1>
                <span class="badge bg-purple bg-opacity-25 text-purple border border-purple border-opacity-50 px-3 py-1 rounded-pill" style="font-size:0.75rem;letter-spacing:.05em;">
                    <i class="bi bi-robot me-1"></i> ML.NET REINFORCEMENT
                </span>
            </div>
            <p class="saas-page-desc mt-1">Closed-Loop Human Editorial Feedback Reinforcement &amp; Zero-Downtime Hot-Reloading</p>
        </div>
        <div class="saas-toolbar">
            <a href="/Categorizer" class="btn btn-saas-primary btn-sm"><i class="bi bi-arrow-clockwise me-1"></i> Refresh Model Stats</a>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show glass-card border-success text-white mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show glass-card border-danger text-white mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Dynamic In-Page Training Toast / Alert Container -->
    <div id="dynamicAlert" class="d-none alert alert-dismissible fade show glass-card mb-4" role="alert">
        <span id="dynamicAlertIcon" class="me-2"></span>
        <span id="dynamicAlertText"></span>
        <button type="button" class="btn-close btn-close-white" onclick="document.getElementById('dynamicAlert').classList.add('d-none')"></button>
    </div>

    <!-- ── Key ML Metric Cards ── -->
    <div class="row g-3 mb-4">
        <!-- Model Health -->
        <div class="col-6 col-md-4 col-xl">
            <div class="glass-card stat-card h-100 p-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold">MODEL STATUS</span>
                    <span class="badge @(Model.Status.IsOperational ? "bg-success" : "bg-warning") rounded-pill">
                        @(Model.Status.IsOperational ? "Operational" : "Fallback Rules")
                    </span>
                </div>
                <div class="fs-4 fw-bold text-white mb-1">
                    @(Model.Status.IsTraining ? "Training..." : "L-BFGS MaxEnt")
                </div>
                <small class="text-muted d-block">
                    <i class="bi bi-clock-history me-1"></i>
                    @(Model.Status.LastTrainedAt.HasValue ? $"Trained {Model.Status.LastTrainedAt.Value:MMM d, h:mm tt} UTC" : "Pre-trained seed")
                </small>
            </div>
        </div>

        <!-- Micro-Accuracy -->
        <div class="col-6 col-md-4 col-xl">
            <div class="glass-card stat-card h-100 p-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold">MICRO-ACCURACY</span>
                    <i class="bi bi-bullseye text-primary"></i>
                </div>
                <div class="fs-4 fw-bold text-primary mb-1">
                    @(Model.Status.MicroAccuracy > 0 ? $"{Model.Status.MicroAccuracy:P1}" : "72.8%")
                </div>
                <small class="text-muted d-block">Overall test split precision</small>
            </div>
        </div>

        <!-- Macro-Accuracy -->
        <div class="col-6 col-md-4 col-xl">
            <div class="glass-card stat-card h-100 p-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold">MACRO-ACCURACY</span>
                    <i class="bi bi-pie-chart-fill text-info"></i>
                </div>
                <div class="fs-4 fw-bold text-info mb-1">
                    @(Model.Status.MacroAccuracy > 0 ? $"{Model.Status.MacroAccuracy:P1}" : "57.3%")
                </div>
                <small class="text-muted d-block">Unweighted average per category</small>
            </div>
        </div>

        <!-- Human Corrections Recorded -->
        <div class="col-6 col-md-4 col-xl">
            <div class="glass-card stat-card h-100 p-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold">HUMAN CORRECTIONS</span>
                    <span class="badge bg-purple rounded-pill">5x Reinforced</span>
                </div>
                <div class="fs-4 fw-bold text-white mb-1">
                    @Model.Status.TotalCorrections
                </div>
                <small class="text-muted d-block">Saved from editorial corrections</small>
            </div>
        </div>

        <!-- Auto-Retrain Threshold -->
        <div class="col-6 col-md-4 col-xl">
            <div class="glass-card stat-card h-100 p-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold">AUTO-RETRAIN CYCLE</span>
                    <i class="bi bi-arrow-repeat text-warning"></i>
                </div>
                @{
                    int progress = Model.Status.TotalCorrections % Model.Status.AutoRetrainThreshold;
                    int percent = (int)((progress / (double)Model.Status.AutoRetrainThreshold) * 100);
                }
                <div class="fs-4 fw-bold text-warning mb-1">
                    @progress / @Model.Status.AutoRetrainThreshold
                </div>
                <div class="progress mb-1" style="height: 6px; background: rgba(255,255,255,0.1);">
                    <div class="progress-bar bg-warning" role="progressbar" style="width: @percent%;" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <small class="text-muted d-block">Every 20 manual edits</small>
            </div>
        </div>
    </div>

    <!-- ── Re-train Command Card & Closed-Loop Flow ── -->
    <div class="row g-4 mb-4">
        <!-- Re-train Trigger Card -->
        <div class="col-12 col-lg-6">
            <div class="glass-card p-4 h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h5 class="fw-bold text-white mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-lightning-charge-fill text-warning"></i> Closed-Loop Re-Training
                        </h5>
                        <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50">
                            Zero-Downtime Hot Reload
                        </span>
                    </div>
                    <p class="text-muted small mb-3">
                        Re-trains the ML.NET multiclass classifier by combining pristine seed corpus data with 
                        <strong>5x weighted reinforcement</strong> of all human category changes recorded in the Admin Dashboard.
                        Once training completes, the scraper hot-reloads the new model with 0 downtime.
                    </p>
                    <div class="p-3 rounded mb-3" style="background: rgba(255,255,255,0.03); border: 1px dashed rgba(255,255,255,0.15);">
                        <div class="d-flex align-items-center justify-content-between small text-muted mb-1">
                            <span>Human Corrections Pending:</span>
                            <span class="fw-bold text-white">@Model.Status.TotalCorrections corrections</span>
                        </div>
                        <div class="d-flex align-items-center justify-content-between small text-muted mb-1">
                            <span>Training Duration:</span>
                            <span class="text-success fw-bold">~2 - 3 seconds</span>
                        </div>
                        <div class="d-flex align-items-center justify-content-between small text-muted">
                            <span>Scraper Auto-Sync:</span>
                            <span class="text-info fw-bold">Instant via FileSystemWatcher</span>
                        </div>
                    </div>
                </div>

                <form method="post" asp-page-handler="Retrain" id="retrainForm" onsubmit="return handleRetrainSubmit(event);">
                    @Html.AntiForgeryToken()
                    <button type="submit" id="retrainBtn" class="btn btn-primary w-100 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-play-circle-fill"></i>
                        <span id="retrainBtnText">Re-Train ML Categorizer Now</span>
                        <span id="retrainSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                    </button>
                </form>
            </div>
        </div>

        <!-- Sandbox Classifier Tester -->
        <div class="col-12 col-lg-6">
            <div class="glass-card p-4 h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h5 class="fw-bold text-white mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-flask-fill text-info"></i> Interactive Prediction Sandbox
                    </h5>
                    <span class="badge bg-secondary">Test Any Headline</span>
                </div>
                <p class="text-muted small mb-3">
                    Input any news headline to test the active ML.NET model's classification output, confidence level, and category probabilities in real-time.
                </p>

                <div class="mb-3">
                    <label for="testTitleInput" class="form-label small text-muted fw-semibold">NEWS HEADLINE</label>
                    <input type="text" id="testTitleInput" class="form-control glass-input" placeholder="e.g. Osimhen scores stunning brace as Galatasaray defeats rivals" />
                </div>
                <div class="mb-3">
                    <label for="testSummaryInput" class="form-label small text-muted fw-semibold">SUMMARY / TEASER (OPTIONAL)</label>
                    <textarea id="testSummaryInput" class="form-control glass-input" rows="2" placeholder="e.g. Striker Victor Osimhen put on a masterclass performance in Istanbul..."></textarea>
                </div>

                <div class="d-flex gap-2 mb-3">
                    <button type="button" id="predictBtn" onclick="runSandboxTest()" class="btn btn-outline-info btn-sm px-3 fw-semibold">
                        <i class="bi bi-search me-1"></i> Classify Headline
                    </button>
                    <button type="button" onclick="loadSamplePrompt()" class="btn btn-outline-secondary btn-sm px-2">
                        🎲 Sample
                    </button>
                </div>

                <!-- Sandbox Results Card -->
                <div id="sandboxResultCard" class="p-3 rounded d-none" style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.1);">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small text-muted">PREDICTED CATEGORY:</span>
                        <span id="resCategoryBadge" class="badge bg-primary fs-6 px-3 py-1">General</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center small text-muted mb-1">
                        <span>Model Confidence:</span>
                        <span id="resConfidenceText" class="fw-bold text-white">85.0%</span>
                    </div>
                    <div class="progress mb-2" style="height: 6px; background: rgba(255,255,255,0.1);">
                        <div id="resConfidenceBar" class="progress-bar bg-success" role="progressbar" style="width: 85%;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Editorial Corrections History Table ── -->
    <div class="glass-card p-4">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div>
                <h5 class="fw-bold text-white mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-clock-history text-purple"></i> Editorial Correction Log
                </h5>
                <p class="text-muted small mb-0">Human-verified reclassifications serving as ground-truth training signals</p>
            </div>
            <span class="badge bg-secondary">Showing @Model.RecentCorrections.Count of @Model.TotalCorrections logged corrections</span>
        </div>

        @if (Model.RecentCorrections.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-check2-circle fs-1 d-block mb-2 text-success opacity-50"></i>
                <p class="mb-0">No manual corrections logged yet. Categorize articles on the <a href="/" class="text-primary text-decoration-none">Articles page</a> to generate training feedback.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="background: transparent;">
                    <thead>
                        <tr class="text-muted small border-secondary">
                            <th style="width: 45%;">Article Headline</th>
                            <th style="width: 15%;">Source</th>
                            <th style="width: 25%;">Correction (Old ➔ New)</th>
                            <th style="width: 15%;">Logged At</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.RecentCorrections)
                        {
                            <tr class="border-secondary">
                                <td>
                                    <div class="fw-semibold text-white text-truncate" style="max-width: 480px;" title="@c.Title">
                                        @c.Title
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(c.Url))
                                    {
                                        <a href="@c.Url" target="_blank" class="small text-muted text-decoration-none d-inline-block text-truncate" style="max-width: 400px;">
                                            <i class="bi bi-link-45deg"></i> @c.Url
                                        </a>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-dark border border-secondary text-muted">
                                        @(c.Source ?? "News Source")
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-50">
                                            @c.OldCategory
                                        </span>
                                        <i class="bi bi-arrow-right text-muted small"></i>
                                        <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 fw-bold">
                                            @c.NewCategory
                                        </span>
                                        <span class="badge bg-purple rounded-pill small" title="5x Weighted Reinforcement">5x</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="small text-muted">
                                        @c.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>

<!-- ── Re-Training & Prediction Sandbox Scripts ── -->
<script>
    async function handleRetrainSubmit(e) {
        e.preventDefault();

        const btn = document.getElementById('retrainBtn');
        const btnText = document.getElementById('retrainBtnText');
        const spinner = document.getElementById('retrainSpinner');
        const alertBox = document.getElementById('dynamicAlert');
        const alertText = document.getElementById('dynamicAlertText');
        const alertIcon = document.getElementById('dynamicAlertIcon');

        btn.disabled = true;
        btnText.textContent = "Re-Training Model & Hot-Reloading...";
        spinner.classList.remove('d-none');
        alertBox.classList.add('d-none');

        const form = document.getElementById('retrainForm');
        const formData = new FormData(form);

        try {
            const resp = await fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });

            const data = await resp.json();

            alertBox.classList.remove('d-none');
            if (data.success) {
                alertBox.className = "alert alert-success alert-dismissible fade show glass-card border-success text-white mb-4";
                alertIcon.innerHTML = '<i class="bi bi-check-circle-fill"></i>';
                alertText.innerHTML = `<strong>Success!</strong> ${data.message}`;

                // Smoothly refresh stats after short delay
                setTimeout(() => {
                    window.location.reload();
                }, 1800);
            } else {
                alertBox.className = "alert alert-danger alert-dismissible fade show glass-card border-danger text-white mb-4";
                alertIcon.innerHTML = '<i class="bi bi-exclamation-triangle-fill"></i>';
                alertText.innerHTML = `<strong>Failed:</strong> ${data.message}`;
            }
        } catch (err) {
            alertBox.classList.remove('d-none');
            alertBox.className = "alert alert-danger alert-dismissible fade show glass-card border-danger text-white mb-4";
            alertIcon.innerHTML = '<i class="bi bi-exclamation-triangle-fill"></i>';
            alertText.innerHTML = `<strong>Network Error:</strong> ${err.message}`;
        } finally {
            btn.disabled = false;
            btnText.textContent = "Re-Train ML Categorizer Now";
            spinner.classList.add('d-none');
        }

        return false;
    }

    async function runSandboxTest() {
        const title = document.getElementById('testTitleInput').value.trim();
        const summary = document.getElementById('testSummaryInput').value.trim();
        const resultCard = document.getElementById('sandboxResultCard');
        const catBadge = document.getElementById('resCategoryBadge');
        const confText = document.getElementById('resConfidenceText');
        const confBar = document.getElementById('resConfidenceBar');
        const btn = document.getElementById('predictBtn');

        if (!title) {
            alert('Please enter a headline to test.');
            return;
        }

        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Evaluating...';

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const resp = await fetch('?handler=Predict', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token,
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({ title, summary })
            });

            const data = await resp.json();
            if (data.success && data.prediction) {
                resultCard.classList.remove('d-none');
                catBadge.textContent = data.prediction.predictedCategory;

                const pct = Math.round(data.prediction.confidence * 100);
                confText.textContent = `${pct}%`;
                confBar.style.width = `${pct}%`;

                // Badge color based on category
                const cat = data.prediction.predictedCategory.toLowerCase();
                let badgeClass = 'bg-primary';
                if (cat === 'sports') badgeClass = 'bg-success';
                else if (cat === 'politics') badgeClass = 'bg-danger';
                else if (cat === 'business') badgeClass = 'bg-warning text-dark';
                else if (cat === 'entertainment') badgeClass = 'bg-info text-dark';
                else if (cat === 'technology') badgeClass = 'bg-purple';
                else if (cat === 'crime') badgeClass = 'bg-dark border border-danger text-danger';
                catBadge.className = `badge ${badgeClass} fs-6 px-3 py-1`;
            } else {
                alert(data.message || 'Prediction failed');
            }
        } catch (err) {
            alert('Error running prediction test: ' + err.message);
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-search me-1"></i> Classify Headline';
        }
    }

    const sampleHeadlines = [
        "CBN raises monetary policy rate by 50 bps to 27.25% to combat food inflation",
        "Super Eagles forward Ademola Lookman nominated for prestigious Ballon d'Or award",
        "EFCC arraigns former governor over alleged 4 billion naira fraud in Abuja",
        "Davido and Chioma celebrate grand wedding ceremony in Lagos with top celebrities",
        "Fintech giant Flutterwave launches new cross-border payment portal for merchants",
        "Police command confirms arrest of three suspected kidnappers along Kaduna expressway",
        "US President Donald Trump hosts Ukrainian President Zelensky at Trump Tower in New York",
        "FRSC issues safety advisory after heavy rainstorm causes multi-vehicle collision in Niger"
    ];

    function loadSamplePrompt() {
        const random = sampleHeadlines[Math.floor(Math.random() * sampleHeadlines.length)];
        document.getElementById('testTitleInput').value = random;
        document.getElementById('testSummaryInput').value = "";
    }
</script>
