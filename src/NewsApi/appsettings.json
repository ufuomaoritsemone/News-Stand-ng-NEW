{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "NewsDb": "Data Source=news.db"
  },
  // Fix #26: explicit provider key instead of fragile connection-string sniffing
  // Values: "sqlite" | "postgres"
  "DbProvider": "sqlite",
  // Write endpoints and Gemini are secured via API_KEY and GEMINI_API_KEY in the .env file.
  "AiEnrichment": {
    "GeminiEnabled": true,
    "AuditLogPath": "logs/gemini_ai_audit.log"
  },
  "Gemini": {
    "Model": "gemini-3.1-flash-lite"
  },
  // Fix #2: explicit CORS allowlist. Add your admin dashboard origin here.
  // Empty = localhost-only fallback (safe for development).
  "AllowedOrigins": [],
  "RateLimiting": {
    "PermitLimit": 600
  },
  // Fix #30: background sync interval in minutes
  "MediaSync": {
    "IntervalMinutes": 15
  },
  // Set via dotnet user-secrets (dev) or environment variable YOUTUBE_API_KEY (prod)
