# ==============================================================================
# Nigerian News Grid ("News Stand NG") — Environment Configuration Template
# Copy this file to `.env` and populate values before running `docker compose up`
# ==============================================================================

# 1. PostgreSQL Database Credentials (Required)
POSTGRES_DB=newsgrid
POSTGRES_USER=newsuser
POSTGRES_PASSWORD=replace_with_strong_postgres_password

# 2. Internal Service & Admin API Key (Required)
# Shared across NewsApi, AdminDashboard, NewsScraperService, and TtsWorker
API_KEY=replace_with_32_byte_random_api_key

# 3. Optional External API Keys (Graceful fallbacks active when omitted)
GEMINI_API_KEY=
YOUTUBE_API_KEY=
GCP_TTS_API_KEY=
INDEXNOW_KEY=
