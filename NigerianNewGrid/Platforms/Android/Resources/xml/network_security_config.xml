<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow clear-text HTTP for local development servers and media blogs. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">host.docker.internal</domain>
        <domain includeSubdomains="true">lindaikejisblog.com</domain>
        <domain includeSubdomains="true">lindaikeji.blogspot.com</domain>
        <domain includeSubdomains="true">lindaikeji.ng</domain>
        <domain includeSubdomains="true">blogspot.com</domain>
        <domain includeSubdomains="true">blogger.com</domain>
        <domain includeSubdomains="true">ytimg.com</domain>
        <domain includeSubdomains="true">youtube.com</domain>
        <domain includeSubdomains="true">ggpht.com</domain>
        <domain includeSubdomains="true">googleusercontent.com</domain>
    </domain-config>
</network-security-config>
