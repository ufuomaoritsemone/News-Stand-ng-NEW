<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NigerianNewGrid.OnboardingPage"
             Title="Welcome"
             Background="{StaticResource SecondaryLightBrush}"
             SafeAreaEdges="Container">

    <Grid RowDefinitions="*,Auto">
        <!-- Scrollable Content Area -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="20" Padding="20,24,20,24">

                <!-- Header & App Introduction -->
                <VerticalStackLayout Spacing="8">
                    <Border StrokeShape="RoundRectangle 20"
                            BackgroundColor="{StaticResource AccentBlueLight}"
                            StrokeThickness="0"
                            HorizontalOptions="Start"
                            Padding="12,4">
                        <Label Text="WELCOME TO NEWS STAND NG"
                               FontFamily="LegacySansBook"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{StaticResource AccentBlue}" />
                    </Border>

                    <Label Text="Your news, tailored to you"
                           FontFamily="LegacySerifBold"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource DarkTextPrimary}}"
                           SemanticProperties.HeadingLevel="Level1" />

                    <Label Text="Configure your language and notification preferences to get the most out of your daily briefings."
                           FontFamily="LegacySansBook"
                           FontSize="14"
                           TextColor="{StaticResource Gray500}"
                           LineHeight="1.2" />
                </VerticalStackLayout>

                <!-- Section 1: Language Selection -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="1. BRIEFING LANGUAGE"
                           FontFamily="LegacySansBook"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Gray500}" />

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <!-- English -->
                        <Border x:Name="CardLangEnglish"
                                Grid.Row="0" Grid.Column="0"
                                Padding="14,12"
                                Background="{StaticResource WhiteBrush}"
                                StrokeShape="RoundRectangle 14"
                                StrokeThickness="1.5"
                                Stroke="{StaticResource AccentBlueBrush}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLanguageCardTapped" CommandParameter="English" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="🇬🇧  English"
                                       FontFamily="LegacySansBook"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource DarkTextPrimary}}"
                                       VerticalOptions="Center" />
                                <Label x:Name="CheckLangEnglish"
                                       Grid.Column="1"
                                       Text="✓"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource AccentBlue}"
                                       IsVisible="True"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Yoruba -->
                        <Border x:Name="CardLangYoruba"
                                Grid.Row="0" Grid.Column="1"
                                Padding="14,12"
                                Background="{StaticResource WhiteBrush}"
                                StrokeShape="RoundRectangle 14"
                                StrokeThickness="1"
                                Stroke="{StaticResource Gray100Brush}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLanguageCardTapped" CommandParameter="Yoruba" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="🇳🇬  Yoruba"
                                       FontFamily="LegacySansBook"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource DarkTextPrimary}}"
                                       VerticalOptions="Center" />
                                <Label x:Name="CheckLangYoruba"
                                       Grid.Column="1"
                                       Text="✓"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource AccentBlue}"
                                       IsVisible="False"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Igbo -->
                        <Border x:Name="CardLangIgbo"
                                Grid.Row="1" Grid.Column="0"
                                Padding="14,12"
                                Background="{StaticResource WhiteBrush}"
                                StrokeShape="RoundRectangle 14"
                                StrokeThickness="1"
                                Stroke="{StaticResource Gray100Brush}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLanguageCardTapped" CommandParameter="Igbo" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="🇳🇬  Igbo"
                                       FontFamily="LegacySansBook"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource DarkTextPrimary}}"
                                       VerticalOptions="Center" />
                                <Label x:Name="CheckLangIgbo"
                                       Grid.Column="1"
                                       Text="✓"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource AccentBlue}"
                                       IsVisible="False"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Hausa -->
                        <Border x:Name="CardLangHausa"
                                Grid.Row="1" Grid.Column="1"
                                Padding="14,12"
                                Background="{StaticResource WhiteBrush}"
                                StrokeShape="RoundRectangle 14"
                                StrokeThickness="1"
                                Stroke="{StaticResource Gray100Brush}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLanguageCardTapped" CommandParameter="Hausa" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="🇳🇬  Hausa"
                                       FontFamily="LegacySansBook"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource DarkTextPrimary}}"
                                       VerticalOptions="Center" />
                                <Label x:Name="CheckLangHausa"
                                       Grid.Column="1"
                                       Text="✓"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource AccentBlue}"
                                       IsVisible="False"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- Section 2: Notifications & Briefings -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="2. NOTIFICATIONS &amp; BRIEFINGS"
                           FontFamily="LegacySansBook"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Gray500}" />

                    <Border Padding="16,14"
                            Background="{StaticResource WhiteBrush}"
                            StrokeShape="RoundRectangle 16"
                            StrokeThickness="1"
                            Stroke="{StaticResource Gray100Brush}">
                        <VerticalStackLayout Spacing="14">

                            <!-- Morning Briefing Switch -->
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Daily Morning Briefing"
                                           FontFamily="LegacySansBook"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource DarkTextPrimary}}" />
                                    <Label Text="AI summary delivered directly to your lockscreen"
                                           FontFamily="LegacySansBook"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray500}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1"
                                        x:Name="SwitchMorningBriefing"
                                        IsToggled="True"
                                        OnColor="{StaticResource AccentBlue}"
                                        ThumbColor="{AppThemeBinding Light=White, Dark={StaticResource DarkTextPrimary}}"
                                        Toggled="OnMorningToggled"
                                        VerticalOptions="Center" />
                            </Grid>

                            <!-- Delivery Time Picker -->
                            <Border x:Name="MorningTimeContainer"
                                    Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource DarkSurfaceCard}}"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="0"
                                    Padding="12,8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Delivery Time"
                                           FontFamily="LegacySansBook"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource DarkTextPrimary}}"
                                           VerticalOptions="Center" />
                                    <TimePicker Grid.Column="1"
                                                x:Name="TimePickerMorning"
                                                Time="07:30:00"
                                                Format="t"
                                                TextColor="{AppThemeBinding Light={StaticResource AccentBlue}, Dark={StaticResource DarkPrimary}}"
                                                FontAttributes="Bold"
                                                VerticalOptions="Center" />
                                </Grid>
                            </Border>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource DarkSurfaceCard}}" />

                            <!-- Audio Briefings Switch -->
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Audio Briefings"
                                           FontFamily="LegacySansBook"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource DarkTextPrimary}}" />
                                    <Label Text="Twice daily audio digests (8:00 AM &amp; 6:00 PM WAT)"
                                           FontFamily="LegacySansBook"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray500}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1"
                                        x:Name="SwitchAudioBriefings"
                                        IsToggled="True"
                                        OnColor="{StaticResource AccentBlue}"
                                        ThumbColor="{AppThemeBinding Light=White, Dark={StaticResource DarkTextPrimary}}"
                                        VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource DarkSurfaceCard}}" />

                            <!-- Keyword Alerts Switch -->
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Breaking Keyword Alerts"
                                           FontFamily="LegacySansBook"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource DarkTextPrimary}}" />
                                    <Label Text="Instant notifications when monitored stories break"
                                           FontFamily="LegacySansBook"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray500}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1"
                                        x:Name="SwitchKeywordAlerts"
                                        IsToggled="True"
                                        OnColor="{StaticResource AccentBlue}"
                                        ThumbColor="{AppThemeBinding Light=White, Dark={StaticResource DarkTextPrimary}}"
                                        Toggled="OnKeywordAlertsToggled"
                                        VerticalOptions="Center" />
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Section 3: Initial Monitored Topics -->
                <VerticalStackLayout x:Name="TopicsSection" Spacing="8">
                    <Label Text="3. TOPICS OF INTEREST"
                           FontFamily="LegacySansBook"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Gray500}" />

                    <Label Text="Tap topics you care about to monitor and receive alerts for:"
                           FontFamily="LegacySansBook"
                           FontSize="12"
                           TextColor="{StaticResource Gray500}"
                           Margin="0,0,0,4" />

                    <!-- Dynamic Chip Container -->
                    <FlexLayout x:Name="FlexTopics"
                                Wrap="Wrap"
                                Direction="Row"
                                AlignItems="Start"
                                AlignContent="Start" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Fixed Bottom Action Bar -->
        <Border Grid.Row="1"
                Background="{AppThemeBinding Light=White, Dark={StaticResource DarkSurfaceCard}}"
                StrokeShape="Rectangle"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource DarkSurfaceCard}}"
                Padding="20,16">
            <VerticalStackLayout Spacing="8">
                <Button x:Name="BtnGetStarted"
                        Text="Get Started"
                        FontFamily="LegacySansBook"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="{StaticResource AccentBlue}"
                        HeightRequest="52"
                        CornerRadius="26"
                        Clicked="OnGetStartedClicked" />

                <Label Text="You can update these preferences anytime in Settings"
                       FontFamily="LegacySansBook"
                       FontSize="11"
                       TextColor="{StaticResource Gray500}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>
